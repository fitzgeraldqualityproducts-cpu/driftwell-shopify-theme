<section class="dw-container" style="padding:40px var(--dw-gutter);">
  <div style="position:relative; border-radius:var(--dw-radius-lg); overflow:hidden; min-height:380px; display:flex; align-items:center; justify-content:center; text-align:center;">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 1800 }}" alt="" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;">
    {% else %}
      <div style="position:absolute; inset:0; background:var(--dw-charcoal);"></div>
    {% endif %}
    <div style="position:absolute; inset:0; background:rgba(0,0,0,0.4);"></div>
    <div style="position:relative; color:#fff; max-width:480px; padding:32px;">
      <h2 class="dw-heading" style="font-size:34px; color:#fff;">{{ section.settings.heading }}</h2>
      <p class="dw-body" style="color:rgba(255,255,255,0.85);">{{ section.settings.subheading }}</p>
      <a href="{{ section.settings.button_link }}" class="dw-btn dw-btn--light" style="margin-top:16px;">{{ section.settings.button_text }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to Sleep Better?" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Effortless comfort is only a click away." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop Bestsellers" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Final CTA" }]
}
{% endschema %}

<section class="dw-section" style="padding-top:0; padding-bottom:0;">
  <div style="position:relative; min-height:{{ section.settings.height }}px; display:flex; align-items:flex-end; overflow:hidden; border-radius:0 0 var(--dw-radius-lg) var(--dw-radius-lg);">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;">
    {% else %}
      <div style="position:absolute; inset:0; background:var(--dw-cream);"></div>
    {% endif %}
    <div style="position:absolute; inset:0; background:linear-gradient(0deg, rgba(0,0,0,0.45), rgba(0,0,0,0) 55%);"></div>

    <div class="dw-container" style="position:relative; padding-bottom:64px; padding-top:120px; color:#fff; max-width:560px;">
      {% if section.settings.eyebrow != blank %}
        <p class="dw-eyebrow" style="color:rgba(255,255,255,0.85);">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h1 class="dw-heading" style="font-size:clamp(32px, 5vw, 56px); color:#fff;">{{ section.settings.heading }}</h1>
      <p class="dw-body" style="color:rgba(255,255,255,0.85); font-size:16px; max-width:420px;">{{ section.settings.subheading }}</p>

      <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:20px;">
        {% if section.settings.primary_cta_text != blank %}
          <a href="{{ section.settings.primary_cta_link }}" class="dw-btn dw-btn--light">{{ section.settings.primary_cta_text }}</a>
        {% endif %}
        {% if section.settings.secondary_cta_text != blank %}
          <a href="{{ section.settings.secondary_cta_link }}" class="dw-btn dw-btn--secondary" style="border-color:#fff; color:#fff;">{{ section.settings.secondary_cta_text }}</a>
        {% endif %}
      </div>

      {% if section.settings.show_countdown %}
        <div style="margin-top:28px;">
          <p class="dw-eyebrow" style="color:rgba(255,255,255,0.7);">Sale ends in</p>
          <div id="dw-countdown" data-end="{{ section.settings.countdown_end }}" style="font-family:var(--dw-font-heading); font-size:28px;">00:00:00</div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% if section.settings.show_countdown %}
<script>
  (function () {
    var el = document.getElementById('dw-countdown');
    if (!el) return;
    var end = new Date(el.getAttribute('data-end')).getTime();
    function tick() {
      var now = Date.now();
      var diff = Math.max(0, end - now);
      var h = Math.floor(diff / 3.6e6);
      var m = Math.floor((diff % 3.6e6) / 6e4);
      var s = Math.floor((diff % 6e4) / 1000);
      el.textContent = [h, m, s].map(function (n) { return String(n).padStart(2, '0'); }).join(' : ');
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fall sale — 20% off sitewide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Best Sleep Starts Here" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Cloud-like comfort, cooling materials, and thoughtful design for better nights." },
    { "type": "text", "id": "primary_cta_text", "label": "Primary button text", "default": "Shop Bestsellers" },
    { "type": "url", "id": "primary_cta_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_cta_text", "label": "Secondary button text", "default": "Explore Bedding" },
    { "type": "url", "id": "secondary_cta_link", "label": "Secondary button link" },
    { "type": "range", "id": "height", "label": "Height (px)", "min": 400, "max": 800, "step": 20, "default": 620 },
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown timer", "default": false },
    { "type": "text", "id": "countdown_end", "label": "Countdown end (ISO datetime)", "info": "e.g. 2026-12-01T00:00:00" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}

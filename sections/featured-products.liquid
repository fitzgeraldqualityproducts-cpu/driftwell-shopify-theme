<section class="dw-section">
  <div class="dw-container">
    <div class="dw-section-head">
      <p class="dw-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="dw-heading" style="font-size:32px;">{{ section.settings.heading }}</h2>
      <p class="dw-body">{{ section.settings.subheading }}</p>
    </div>

    <div class="dw-grid">
      {% assign coll = collections[section.settings.collection] %}
      {% if coll != blank %}
        {% for product in coll.products limit: section.settings.limit %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop the collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore Our Most Loved Sleep Products" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Thoughtfully designed sleep essentials that make every night more comfortable." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 16, "step": 4, "default": 8 }
  ],
  "presets": [{ "name": "Featured products grid" }]
}
{% endschema %}

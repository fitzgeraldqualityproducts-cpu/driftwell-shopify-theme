<section class="dw-section dw-section--tight">
  <div class="dw-container">
    <div class="dw-section-head">
      <p class="dw-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="dw-heading" style="font-size:28px;">{{ section.settings.heading }}</h2>
    </div>

    <div class="dw-pillars">
      {% for block in section.blocks %}
        <div {{ block.shopify_attributes }}>
          <p class="dw-pillar__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
          <p style="font-weight:600; letter-spacing:0.04em; text-transform:uppercase; font-size:13px; margin:8px 0;">{{ block.settings.title }}</p>
          <p class="dw-body">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why us — pillars",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Driftwell" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Designed around how you actually sleep" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Adaptive Comfort" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Designed around the way you naturally sleep." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why us — pillars",
      "blocks": [
        { "type": "pillar", "settings": { "title": "Adaptive Comfort", "text": "Designed around the way you naturally sleep." } },
        { "type": "pillar", "settings": { "title": "Cooling Technology", "text": "Breathable materials designed to help you stay comfortable all night." } },
        { "type": "pillar", "settings": { "title": "Cloud-Like Softness", "text": "Premium materials engineered for exceptional softness and everyday comfort." } }
      ]
    }
  ]
}
{% endschema %}

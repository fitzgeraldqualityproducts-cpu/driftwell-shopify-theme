<section class="dw-section">
  <div class="dw-container">
    <div class="dw-section-head">
      <p class="dw-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="dw-heading" style="font-size:30px;">{{ section.settings.heading }}</h2>
    </div>

    <div class="dw-carousel">
      {% for block in section.blocks %}
        <div class="dw-review-card" {{ block.shopify_attributes }}>
          <div class="dw-stars">
            {% for i in (1..5) %}{% if i <= block.settings.rating %}★{% else %}☆{% endif %}{% endfor %}
          </div>
          <p class="dw-review-quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
          <p class="dw-review-meta">
            <span class="dw-verified">{{ block.settings.name }}</span>
            {% if block.settings.verified %} · Verified Buyer{% endif %}
            {% if block.settings.product != blank %}<br>{{ block.settings.product }}{% endif %}
          </p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Customers Are Saying" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "I finally stopped waking up with a sore neck." },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Sarah M." },
        { "type": "checkbox", "id": "verified", "label": "Show Verified Buyer badge", "default": true },
        { "type": "text", "id": "product", "label": "Product purchased (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "review" },
        { "type": "review", "settings": { "name": "Jake D.", "quote": "Setup took two minutes and it actually feels supportive, not stiff." } },
        { "type": "review", "settings": { "name": "Priya K.", "quote": "Best pillow I've owned — my neck tension is basically gone." } }
      ]
    }
  ]
}
{% endschema %}
